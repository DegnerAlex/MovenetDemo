{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Movenet Demo",
  "mainBinaryName": "movenet-demo",
  "version": "0.1.0",
  "identifier": "org.ergofox.exergame",
  "build": {
    "devUrl": "http://localhost:9999",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Movenet Demo",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "target/release/ort-gpu-bundle/*": "ort-gpu-bundle/"
    }
  }
}
